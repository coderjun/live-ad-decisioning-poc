TYPESAFE_API_KEY=
FAL_KEY=
# Minimum calibrated probability each judgment must clear
THRESHOLD_BRAND_SAFE=0.90
THRESHOLD_CONTEXT_FIT=0.75
# Generation budget: fal's free tier is five generations per day, each up to 15 seconds
GENERATIONS_PER_DAY=5
MAX_GENERATED_SECONDS=15
GENERATION_RESOLUTION=480P
# Queue, upload, and download on top of fal's published inference time
GENERATION_OVERHEAD_SECONDS=3
# Estimated fal inference seconds per second of generated clip, used by the clock gate
GENERATION_SECONDS_PER_CLIP_SECOND=0.2
# Optional: pretend today is this date for campaign flight checks (the scorecard pins 2026-10-01)
NOW=
